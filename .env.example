# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openai    # openai | anthropic | ollama
LLM_MODEL=            # required: agent model name from your provider's docs
JUDGE_MODEL=          # required for evals: ideally a different model
LLM_TEMPERATURE=      # optional
EMBEDDINGS=local      # hash (tests only) | openai | local | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=     # only if Ollama runs on another machine, e.g. http://mac-mini.local:11434
OLLAMA_NUM_CTX=      # optional, default 32768; Ollama silently truncates prompts longer than this
OLLAMA_EMBED_MODEL=  # with EMBEDDINGS=ollama; default nomic-embed-text
